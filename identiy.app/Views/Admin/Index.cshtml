@model List<identity.entity.Model.AppUser>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Paneli - Kullanıcılar</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-8">

    <div class="max-w-6xl mx-auto bg-white rounded-lg shadow-md overflow-hidden">
        
        <!-- Üst Menü / Navbar -->
        <div class="bg-indigo-600 px-6 py-4 flex justify-between items-center">
            <h2 class="text-xl font-bold text-white">Admin Kontrol Paneli</h2>
            <div class="flex space-x-4">
                <span class="text-indigo-100 text-sm font-medium self-center">Yetki: Admin</span>
                <!-- Çıkış yapıldığında cookie'yi silmek veya Login sayfasına dönmek için link -->
                <a href="/Login/Index" class="bg-indigo-500 hover:bg-indigo-400 text-white px-3 py-1 rounded text-sm transition">Çıkış Yap</a>
            </div>
        </div>
        
        <div class="p-6">
            <h3 class="text-lg font-semibold text-gray-700 mb-4">Sistemde Kayıtlı Kullanıcılar</h3>
            
            <div class="overflow-x-auto rounded-lg border border-gray-200">
                <table class="min-w-full bg-white">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 border-b border-gray-200 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">ID</th>
                            <th class="px-6 py-3 border-b border-gray-200 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Kullanıcı Adı</th>
                            <th class="px-6 py-3 border-b border-gray-200 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">E-Posta</th>
                            <th class="px-6 py-3 border-b border-gray-200 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Mevcut Rol</th>
                            <th class="px-6 py-3 border-b border-gray-200 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Yetki Değiştir</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        @if(Model != null && Model.Any())
                        {
                            // ViewBag üzerinden gönderdiğimiz Dictionary ve List objelerini güvenli bir şekilde alıyoruz
                            var userRoles = ViewBag.UserRoles as Dictionary<int, string> ?? new Dictionary<int, string>();
                            var allRoles = ViewBag.AllRoles as List<identity.entity.Model.AppRole> ?? new List<identity.entity.Model.AppRole>();

                            foreach (var user in Model)
                            {
                                var currentRole = userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : "Rol Yok";

                                <tr class="hover:bg-gray-50 transition duration-150">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@user.Id</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@user.UserName</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@(string.IsNullOrEmpty(user.Email) ? "Belirtilmemiş" : user.Email)</td>
                                    
                                    <td class="px-6 py-4 whitespace-nowrap text-sm">
                                        <!-- Mevcut role göre renklendirme (Admin ise yeşil, diğerleri gri) -->
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full @(currentRole == "Admin" ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800")">
                                            @currentRole
                                        </span>
                                    </td>

                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-center">
                                        <!-- Rol değiştirme formu -->
                                        <form method="post" action="/Admin/ChangeRole" class="flex items-center justify-center space-x-2">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <select name="newRole" class="block w-28 pl-2 pr-8 py-1 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md bg-white border">
                                                @foreach(var role in allRoles)
                                                {
                                                    if(role.Name == currentRole)
                                                    {
                                                        <option value="@role.Name" selected>@role.Name</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@role.Name">@role.Name</option>
                                                    }
                                                }
                                            </select>
                                            <button type="submit" class="bg-indigo-50 text-indigo-600 hover:bg-indigo-100 px-3 py-1 rounded border border-indigo-200 transition text-xs font-medium shadow-sm">Kaydet</button>
                                        </form>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <!-- Sütun sayısı 5'e çıktığı için colspan=5 yaptık -->
                                <td colspan="5" class="px-6 py-4 text-center text-gray-500">Sistemde henüz kullanıcı bulunmuyor.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="mt-4 text-sm text-gray-500">
                Toplam Kullanıcı Sayısı: <strong>@Model?.Count</strong>
            </div>

        </div>
    </div>

</body>
</html>