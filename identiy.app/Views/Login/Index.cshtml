@model identity.entity.ViewModels.UserViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giriş Yap</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 flex items-center justify-center min-h-screen">

    <div class="bg-white p-8 rounded-lg shadow-md w-full max-w-md">
        <div class="text-center mb-8">
            <h2 class="text-2xl font-bold text-gray-800">Hoş Geldiniz</h2>
            <p class="text-gray-500 text-sm mt-2">Lütfen hesabınıza giriş yapın</p>
        </div>

        <form method="post" class="space-y-4">
            
            <div>
                <label asp-for="UserName" class="block text-sm font-medium text-gray-700 mb-1">Kullanıcı Adı</label>
                <input asp-for="UserName" type="text" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 outline-none transition" />
                <span asp-validation-for="UserName" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1">Şifre</label>
                <input asp-for="Password" type="password" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 outline-none transition" />
                <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="flex items-center justify-end">
                <button type="button" onclick="location.href='/SendMail/ForgotPassword'" class="text-sm text-blue-600 hover:underline">Şifremi Unuttum</button>
            </div>

            <button type="submit" class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:ring-4 focus:ring-blue-200 transition font-medium">Giriş Yap</button>
            
            <div class="relative py-4">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-gray-200"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                    <span class="px-2 bg-white text-gray-500">Hesabınız yok mu?</span>
                </div>
            </div>

            <button type="button" onclick="location.href='/register/register'" class="w-full bg-gray-50 text-gray-700 border border-gray-300 py-2 px-4 rounded-md hover:bg-gray-100 transition font-medium">
                Kayıt Ol
            </button>

            @if(ViewBag.message != null)
            {
                <div class="mt-4 p-3 bg-red-50 text-red-600 rounded-md text-sm text-center">
                    @ViewBag.message
                </div>
            }
        </form>
    </div>

</body>
</html>