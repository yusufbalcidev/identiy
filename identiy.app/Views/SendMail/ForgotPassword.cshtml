@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Şifremi Unuttum</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 flex items-center justify-center min-h-screen">

<div class="bg-white p-8 rounded-lg shadow-md w-full max-w-md">
    <div class="text-center mb-6">
        <h2 class="text-2xl font-bold text-gray-800">Şifremi Unuttum</h2>
        <p class="text-gray-500 text-sm mt-2">Sisteme kayıtlı e-posta adresinizi girin, size bir sıfırlama linki gönderelim.</p>
    </div>

    <form method="post" class="space-y-4">
            
        @if(ViewBag.Message != null)
        {
            <div class="p-3 bg-green-50 text-green-700 rounded-md text-sm text-center border border-green-200">
                @ViewBag.Message
            </div>
        }

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">E-Posta Adresiniz</label>
            <input type="email" name="email" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500 outline-none transition" required />
        </div>
            
        <button type="submit" class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:ring-4 focus:ring-blue-200 transition font-medium mt-4">
            Link Gönder
        </button>

        <div class="text-center mt-4">
            <button type="button" onclick="location.href='/login/index'" class="text-sm text-gray-600 hover:text-blue-600 hover:underline transition">
                Giriş ekranına dön
            </button>
        </div>
    </form>
</div>

</body>
</html>