

@{
    Layout = null;
}

<h2>Şifremi Unuttum</h2>
<p>Sisteme kayıtlı e-posta adresinizi girin, size bir sıfırlama linki gönderelim.</p>

<form method="post">
    <div class="text-success">@ViewBag.Message</div>
    <label>E-Posta Adresiniz</label>
    <input type="email" name="email" class="form-control" required />
    <br />
    <button type="submit" class="btn btn-primary">Link Gönder</button>
</form>